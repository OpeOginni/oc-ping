{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      "package": ".",
      "options": {
        // Recommended: leave credentials empty and export
        // OC_PING_RECIPIENT, SPECTRUM_PROJECT_ID, and SPECTRUM_PROJECT_SECRET.
        // Do not publish or commit a config containing real credentials.
        "recipient": "+15551234567",
        "projectId": "your-photon-project-id",
        "projectSecret": "your-photon-project-secret",
        "deviceName": "Development Mac",
        "events": ["result", "permission", "question"],
        "replies": true
      }
    }
  ]
}
